# Required provider credentials
OPENROUTER_API_KEY=sk-or-v1-your-key-here
TAVILY_API_KEY=tvly-your-key-here

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=b2b-proposal-generator

# Model configuration
LLM_PROVIDER=openrouter
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_TEMPERATURE=0.3
LLM_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# Runtime and persistent storage. Mount the persistent disk at STORAGE_DIR.
PORT=8000
STORAGE_DIR=./storage
CHROMA_PERSIST_DIR=./storage/chroma_db
SQLITE_CHECKPOINT_PATH=./storage/checkpoints.db
OUTPUT_DIR=./storage/output
AUTO_INGEST=true

# Comma-separated browser origins for a separately hosted frontend.
# The unified Docker deployment is same-origin and does not require CORS.
CORS_ORIGINS=http://localhost:3000

# Separate Next.js deployment only:
# API_URL is evaluated when the separate frontend is built and powers /api.
# NEXT_PUBLIC_API_URL can instead be set at that same build time.
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=/api
