# ============================================
# B2B PROPOSAL GENERATOR - ENVIRONMENT CONFIG
# ============================================

# Configure one LLM provider key. GROQ_API_KEY takes precedence when set.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Tavily Web Search (REQUIRED, FREE tier) - Get from: https://tavily.com
TAVILY_API_KEY=

# LangSmith Tracing (OPTIONAL) - Get from: https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=b2b-proposal-generator

# ─── Model Configuration ───
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.3

# Embeddings: HuggingFace all-MiniLM-L6-v2 (FREE, runs locally)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Storage ───
CHROMA_PERSIST_DIR=./chroma_db
SQLITE_CHECKPOINT_PATH=./checkpoints.db
